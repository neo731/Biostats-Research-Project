library(rstan)
library(ggplot2)
library(dplyr)
library(tidyr)
library(magick)
library(truncnorm)
library(cowplot)
setwd('C:/Users/Neo/OneDrive/Documents/Master of Biostats/Research project')
setwd('C:/Users/Neo/OneDrive/Documents/Master of Biostats/Research project/simulation result/expected info')
opt_results <- read.csv("optimisation_results.csv")
design_summary <- opt_results %>%
group_by(design_id, cohort) %>%
summarise(
mean_expected_info = mean(expected_info, na.rm = TRUE)
)
design_summary
View(opt_results)
ggplot(design_summary, aes(x = cohort, y = mean_expected_info, colour = factor(design_id), group = design_id)) +
geom_line(na.rm=TRUE, linewidth = 1) +
scale_color_brewer(palette = "Set1", name = "Design ID") +
labs(title = "Mean expecetd information gain for each design",
x = "Cohort Number",
y = "Mean Information Gain") +
theme_bw()
design_rankings <- design_summary %>%
group_by(design_id) %>%
summarise(
cumulative_info = sum(mean_expected_info, na.rm = TRUE),
mean_info = mean(mean_expected_info, na.rm = TRUE),
final_info = last(mean_expected_info)
) %>%
arrange(desc(mean_info))
design_rankings
# the average expected information per cohort for each design
design_summary <- opt_results %>%
group_by(design_id, cohort) %>%
summarise(
mean_expected_info = mean(expected_info, na.rm = TRUE)
) %>% ungroup()
design_summary
cohort_summary <- opt_results %>%
group_by(design_id, sim_id) %>%
summarise(
cohort_count = mean(count(cohort))
)
sim_summary <- opt_results %>%
group_by(design_id, sim_id) %>%
summarise(
cohort_count = n(),
total_cohort_size = sum(cohort_size)
)
sim_summary
# Calculate the totals per simulation within each design
sim_summary <- opt_results %>%
group_by(design_id, sim_id) %>%
summarise(
cohort_count = n(),
total_cohort_size = sum(cohort_size)
)
# Calculate the averages across simulations *for each design*
design_averages <- sim_summary %>%
group_by(design_id) %>%
summarise(
avg_cohort_count = mean(cohort_count),
avg_total_cohort_size = mean(total_cohort_size)
)
