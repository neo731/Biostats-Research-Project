bias = true_log10 - id70_mean,
bias_lo = true_log10 - id70_hi,
bias_hi = true_log10 - id70_lo,
scenario_label = factor(
scenario_label,
levels = paste("Scenario", 1:5)
)
)
# Add number of trials contributing at each cohort
